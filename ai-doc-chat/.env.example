# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aidocchat
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@localhost:5432/aidocchat

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI providers ──────────────────────────────────────────────────────────────
# Anthropic Claude — chat / completions
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — embeddings (recommended by Anthropic, outperforms OpenAI on RAG)
# Get your key: https://dash.voyageai.com/
VOYAGE_API_KEY=pa-...

# ── Celery / Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development        # development | production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
